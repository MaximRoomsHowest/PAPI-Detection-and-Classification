# Root Compose env file (read automatically by `docker compose`).
#
# Copy this file to `.env` and adjust values for your deployment:
#
#   cp .env.example .env
#
# DO NOT COMMIT THE RESULTING .env FILE — it is gitignored.

# ---------------------------------------------------------------------------
# Postgres credentials
# ---------------------------------------------------------------------------
# Used by the postgres service and consumed by the backend's DATABASE_URL.
# Generate a strong password (e.g. `openssl rand -base64 32`) for any deploy
# beyond local development. Reusing "papi" is fine for local-only runs.
POSTGRES_USER=papi
POSTGRES_PASSWORD=papi

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# `production` flips the security floor: the backend refuses to start without
# PAPI_API_KEY being set. Use `local` (the default) for dev / CI / local Compose.
PAPI_ENV=local

# Required when PAPI_ENV=production. Recommended even in local for parity with
# deployed behaviour. Keep this secret; treat it like a password.
PAPI_API_KEY=

# Host interface the backend port (8000) binds to. Defaults to loopback so the
# unauthenticated local API is not exposed on the LAN (audit DCK-D1); the
# frontend reaches it through its nginx proxy, not this host port. Set to
# 0.0.0.0 only when another machine must reach the API directly — and then also
# set PAPI_ENV=production + PAPI_API_KEY so it is not left open unauthenticated.
PAPI_BACKEND_BIND=127.0.0.1

# Memory ceiling for the backend container (audit DCK-D6). Tune to the host;
# CPU torch inference on a 1280px frame peaks around 2-3 GB.
PAPI_BACKEND_MEM_LIMIT=4g

# Origins allowed by CORS. Only needed for a direct (non-proxied) frontend such
# as the Vite dev server; the production bundle is same-origin via the nginx
# proxy and needs no CORS. Comma-separated or JSON list.
PAPI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Inference tuning. Bounds: 0.0 <= confidence_threshold <= 1.0.
# PAPI_DEVICE: cpu | cuda | 0 (a specific GPU index) | auto (cuda if available, else cpu).
PAPI_DEVICE=cpu
PAPI_CONFIDENCE_THRESHOLD=0.4
PAPI_MAX_UPLOAD_MB=100
PAPI_MAX_IMAGE_MEGAPIXELS=80
PAPI_MAX_VIDEO_FRAMES=600
PAPI_MAX_VIDEO_SECONDS=30
PAPI_VIDEO_HISTORY_SIZE=5
# Aggregate request-body cap for folder/batch uploads.
PAPI_MAX_BATCH_UPLOAD_MB=400
# Max images accepted per folder/batch upload.
PAPI_MAX_BATCH_FRAMES=200

# Optional: cap torch intra-op threads on shared/constrained hosts (audit
# DCK-D13). Inference is serialized (one analysis at a time), so the default
# (all cores) is fine on a dedicated host; set this to match a CPU allocation
# on a shared one, then uncomment the matching line in compose.yaml.
# OMP_NUM_THREADS=4

# ---------------------------------------------------------------------------
# Frontend (build-time)
# ---------------------------------------------------------------------------
# Browser-side backend URL, inlined into the static bundle by Vite at build
# time. Leave EMPTY to use the same-origin nginx reverse proxy (recommended —
# audit DCK-D4): the browser calls /api and /media on the frontend's own origin
# and nginx forwards them to the backend. Set an absolute URL only for a direct
# (non-proxied) backend, which then also needs CSP + CORS adjustments.
FRONTEND_PAPI_API_URL=
