# Root Compose env file (read automatically by `docker compose`).
#
# Copy this file to `.env` and adjust values for your deployment:
#
#   cp .env.example .env
#
# DO NOT COMMIT THE RESULTING .env FILE — it is gitignored.

# ---------------------------------------------------------------------------
# Postgres credentials
# ---------------------------------------------------------------------------
# Used by the postgres service and consumed by the backend's DATABASE_URL.
# Generate a strong password (e.g. `openssl rand -base64 32`) for any deploy
# beyond local development. Reusing "papi" is fine for local-only runs.
POSTGRES_USER=papi
POSTGRES_PASSWORD=papi

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# `production` flips the security floor: the backend refuses to start without
# PAPI_API_KEY being set. Use `local` (the default) for dev / CI / local Compose.
PAPI_ENV=local

# Required when PAPI_ENV=production. Recommended even in local for parity with
# deployed behaviour. Keep this secret; treat it like a password.
PAPI_API_KEY=

# Host interface the backend port (8000) binds to. Defaults to loopback so the
# unauthenticated local API is not exposed on the LAN (audit DCK-D1); the
# frontend reaches it through its nginx proxy, not this host port. Set to
# 0.0.0.0 only when another machine must reach the API directly — and then also
# set PAPI_ENV=production + PAPI_API_KEY so it is not left open unauthenticated.
PAPI_BACKEND_BIND=127.0.0.1

# Memory ceiling for the backend container (audit DCK-D6). Tune to the host;
# CPU torch inference on a 1280px frame peaks around 2-3 GB.
PAPI_BACKEND_MEM_LIMIT=4g

# Origins allowed by CORS. Only needed for a direct (non-proxied) frontend such
# as the Vite dev server; the production bundle is same-origin via the nginx
# proxy and needs no CORS. Comma-separated or JSON list.
PAPI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Inference tuning. Bounds: 0.0 <= confidence_threshold <= 1.0.
# PAPI_DEVICE: cpu | cuda | 0 | auto. NOTE: the local Docker image ships CPU-only torch and the
# stack exposes no GPU, so `auto` resolves to cpu and an explicit cuda/0 falls back to cpu with a
# warning. A real GPU needs a CUDA-torch image + a device reservation (out of scope for this stack).
PAPI_DEVICE=cpu
# Model paths. Under Docker Compose these two are IGNORED — compose.yaml hardcodes
# the container paths (/models/serving/...). They matter only for bare-metal runs
# where the shell exports them; the backend resolves relative values against
# apps/backend/, so repo-root-relative values like "models/serving/best.pt" would
# point at a nonexistent apps/backend/models/ (audit ENV-1). Use the ../../-anchored
# form (or absolute paths) for bare-metal:
# PAPI_MODEL_REGISTRY_PATH=../../models/serving/models.json
# PAPI_MODEL_PATH=../../models/serving/best.pt
# Optional 3-class transition classifier (models/MODELS.md §5c). The registry
# default (data/runs/...) only resolves for bare-metal runs. Under Docker
# Compose the container mounts ONLY ./models, so a data/... value can never
# resolve — copy the weights to models/transition/best.pt (gitignored) and use
# the IN-CONTAINER path:
# PAPI_TRANSITION_MODEL_PATH=/models/transition/best.pt
# Bare-metal override form:
# PAPI_TRANSITION_MODEL_PATH=models/runs/detect/transition3class-yolo26s-1280/weights/best.pt

# Media storage backend: local (default, filesystem under PAPI_STORAGE_DIR) or
# azure_blob. Azure-only settings below are ignored in local mode. In Azure
# Container Apps, prefer a secret-backed connection string for the first demo,
# or set an account URL and grant the Container App managed identity
# Storage Blob Data Contributor.
PAPI_STORAGE_BACKEND=local
PAPI_BLOB_CONTAINER=papi-media
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
PAPI_CONFIDENCE_THRESHOLD=0.4
PAPI_MAX_UPLOAD_MB=100
PAPI_MAX_IMAGE_MEGAPIXELS=80
PAPI_MAX_VIDEO_FRAMES=600
PAPI_MAX_VIDEO_SECONDS=150
# Aggregate request-body cap for folder/batch uploads.
PAPI_MAX_BATCH_UPLOAD_MB=400
# Max images accepted per folder/batch upload.
PAPI_MAX_BATCH_FRAMES=200
# Model lifecycle stores and caps. Under Docker Compose these directories are
# fixed to named volumes (/user_models, /datasets, /jobs); the directory values
# mainly matter for bare-metal runs. The upload/extract caps are forwarded by
# compose.yaml and can be raised for operator-managed model/dataset imports.
#PAPI_USER_MODELS_DIR=storage/user_models
#PAPI_DATASETS_DIR=storage/datasets
#PAPI_JOBS_DIR=storage/jobs
PAPI_MAX_MODEL_UPLOAD_MB=500
PAPI_MAX_DATASET_UPLOAD_MB=500
PAPI_MAX_DATASET_EXTRACT_MB=4000
PAPI_TRAINING_ENABLED=true
# Playback/transition-timing FPS assigned to a folder->video sequence (does not
# affect detection). Bounds: 0 < fps <= 120.
PAPI_SEQUENCE_FPS=4
# Inference input size + NMS IoU, explicit so a re-exported model can never
# silently fall back to Ultralytics' 640 default (all serving checkpoints are
# trained at 1280). Bounds: 320-4096 / 0.0-1.0.
PAPI_INFERENCE_IMGSZ=1280
PAPI_INFERENCE_IOU=0.7

# Postgres connection-pool sizing (bounds: 1-100 / 0-200). The defaults keep
# headroom under Starlette's 40-thread sync pool without holding 40 idle
# connections; SQLite deployments ignore both.
PAPI_DB_POOL_SIZE=10
PAPI_DB_MAX_OVERFLOW=20

# Process-local rate limiting. General dashboard/API traffic has a broad bucket;
# expensive /api/analyze* endpoints have a stricter bucket.
PAPI_RATE_LIMIT_ENABLED=true
PAPI_RATE_LIMIT_PER_MINUTE=600
PAPI_ANALYZE_RATE_LIMIT_PER_MINUTE=60
# Which proxy IPs uvicorn trusts for X-Forwarded-For. Compose defaults this to
# "*" (backend is loopback-bound + only the in-network nginx reaches it) so the
# rate limiter buckets per real client instead of per proxy hop. Tighten to the
# proxy IP/CIDR if you ever expose port 8000 beyond localhost.
#FORWARDED_ALLOW_IPS=*

# CPU thread budget for inference — torch + OpenBLAS + OpenCV + ONNX Runtime + OpenVINO (audit
# DCK-D13). 0 = auto: resolved from the container's real CPU allotment (cgroup-aware on Linux),
# which prevents thread oversubscription under a fractional-CPU cap. Inference is serialized, so
# auto (all cores) is fine on a dedicated host; set it to your CPU/quota count on a shared one.
PAPI_INFERENCE_THREADS=0
# Inference backend. auto = device-aware: on CPU it prefers an OpenVINO IR sibling over best.pt
# (the IR ships only when the image is built with BACKEND_INSTALL_ACCEL=true, see below; otherwise
# it falls back to best.pt). ONNX is opt-in only (slower than .pt on CPU). CUDA uses native best.pt.
PAPI_INFERENCE_BACKEND=auto
# Build the backend image WITH the OpenVINO accelerator (~+400 MB) for a ~1.5x local CPU speedup.
# Off by default to keep the image lean (the .pt fallback runs regardless). After changing this,
# rebuild: `docker compose build backend`.
BACKEND_INSTALL_ACCEL=false

# ---------------------------------------------------------------------------
# Frontend (build-time)
# ---------------------------------------------------------------------------
# Browser-side backend URL, inlined into the static bundle by Vite at build
# time. Leave EMPTY to use the same-origin nginx reverse proxy (recommended —
# audit DCK-D4): the browser calls /api and /media on the frontend's own origin
# and nginx forwards them to the backend. Set an absolute URL only for a direct
# (non-proxied) backend, which then also needs CSP + CORS adjustments.
FRONTEND_PAPI_API_URL=

# ---------------------------------------------------------------------------
# Frontend (runtime)
# ---------------------------------------------------------------------------
# nginx client_max_body_size for the /api reverse proxy, rendered into the
# config at container START (no rebuild needed — audit IS-7). Pair it with
# PAPI_MAX_BATCH_UPLOAD_MB: keep ~10m of multipart headroom above the backend
# budget (defaults: 400 MB budget -> 410m here) or nginx 413s a legal batch
# upload before the backend sees it.
PAPI_NGINX_MAX_BODY_SIZE=410m
