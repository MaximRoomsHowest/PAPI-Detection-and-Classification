# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Local assistant/browser tooling
.claude/
.playwright-cli/

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Local secrets
.env
.env.*
!**/.env.example

# Client/raw data and generated ML artifacts
PROJECT1-PAPI/
PAPI_*/
data/raw/
data/work/
data/interim/*.csv
data/interim/*.json
data/labels/*.yaml
data/labels/auto/
data/labels/verified/
data/annotations/
data/datasets/
data/runs/
data/cvat/

# Model binary artifacts — ignored by default everywhere
runs/
*.pt
*.onnx
*.engine
*.torchscript
*.safetensors
models/**/*.pt
models/**/*.onnx
models/**/*.engine
models/**/*.torchscript
models/**/*.safetensors

# Whitelist: committed model artifacts at their canonical paths
!models/base/*.pt
!models/base/*.onnx
!models/serving/*.pt
!models/serving/*.onnx
!models/runs/
!models/runs/**

# Frontend/backend generated outputs
apps/frontend/node_modules/
apps/frontend/dist/
apps/frontend/coverage/
apps/backend/storage/

# Local trial folders created outside the canonical apps/* workspace.
# Keep source changes in apps/frontend and apps/backend instead.
/frontend/
/backend/

# Generated CVAT/export archives and videos
*.zip
*.mp4
*.avi
!test_videos/*.mp4
!models/runs/**/*.mp4
# Intro hero loop: a real shipped frontend asset (compressed 720p, ~1.5 MB), not a generated artifact.
!apps/frontend/public/intro-hero.mp4
# Live-Demo sample clip the dropzone picker fetches: the real two-minute EDNY
# angle sweep (H.264 1280px, 60 frames @ 0.5 fps, ~8 MB — regenerated by
# docs/user-testing/build_demo_samples.py).
!apps/frontend/public/demo-samples/papi24-angle-sweep.mp4

# --------------------------------------------------------------------------
# Audit / review artefacts (added 2026-05-27 after the v1.1 audit follow-up).
# These are regenerated on demand by visual-review and smoke-test workflows;
# they have no business in the tracked tree.
# --------------------------------------------------------------------------

# Chrome-MCP screenshots produced when running visual reviews against a
# local stack (audit SMOKE-MIN-2). Re-created the next time the same flow
# runs; no commit value.
audit-screenshots/

# Local Compose overrides. Convention is that anyone needing a machine-specific
# tweak drops it here without modifying the canonical compose.yaml. The Tier-A
# CORS workaround that briefly lived here is no longer needed (SMOKE-CRIT-2 is
# fixed), but the convention stays.
compose.override.yaml
docker-compose.override.yml

# Rendered deliverable artifacts (Word/PDF) built from the Markdown sources
# under docs/deliverables/. The .md files are the source of truth; these
# binaries are produced on demand for Leho upload and should not be tracked.
docs/deliverables/_build/

# --------------------------------------------------------------------------
# Local dev / generated artefacts (added 2026-06-03 in the pre-merge cleanup).
# --------------------------------------------------------------------------

# Local SQLite dev DB used by a host `uvicorn` run (outside Docker/Postgres). The
# canonical store is Postgres; this file is per-machine and must never be committed.
*.db

# Generated charts produced on demand (workflows/scripts/plot_angle_distribution.py
# and the project-management burndown tooling) — regenerated, not source.
/angle_distribution.png
docs/deliverables/charts/

# Personal per-member time-tracking exports (not a project deliverable).
docs/timetrack-*.pdf

# Experimental redesigned-frontend extraction, kept on disk for reference only. It is a
# full alternate SPA (its own port/build) and must NOT be merged into apps/frontend — it
# would collide. Keep it out of the tracked tree entirely.
apps/frontend-redesigned-extracted/

# A root-level node_modules is not part of this monorepo (the frontend's deps live under
# apps/frontend/). Ignore a stray root install so it can never be staged by accident.
/node_modules/

# Stray doc artefacts that drifted into the working tree (pre-merge docs cleanup). These
# are generated/transient, not deliverable sources; the height-audit decision record lives
# in BigBrain ([[papi-06-height-audit-2026-06-02]]). Keep them out of the tracked tree.
docs/papi-06-height-audit.md
docs/papi_burndown_data.csv
docs/**/*.pptx

# Local AI/knowledge-graph tooling state: the graph output and agent/tool configs are
# machine-generated per-clone (rebuilt by `graphify update .`) and not project sources.
graphify-out/
.agents/
.codex/
