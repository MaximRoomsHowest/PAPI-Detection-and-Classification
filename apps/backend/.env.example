# local (default) keeps the production security floor off; set "production" at
# real deploy time (then a PAPI_API_KEY and a non-default DATABASE_URL are required).
PAPI_ENV=local
# DATABASE_URL (shown) and PAPI_DATABASE_URL are both accepted.
DATABASE_URL=postgresql+psycopg://papi:papi@localhost:5434/papi_backend
# Postgres connection-pool sizing (bounds: 1-100 / 0-200). The defaults keep
# headroom under Starlette's 40-thread sync pool without holding 40 idle
# connections; SQLite deployments ignore both.
PAPI_DB_POOL_SIZE=10
PAPI_DB_MAX_OVERFLOW=20
PAPI_MODEL_REGISTRY_PATH=../../models/serving/models.json
PAPI_MODEL_PATH=../../models/serving/best.pt
# Optional override if the ignored transition classifier exists locally.
# PAPI_TRANSITION_MODEL_PATH=../../data/runs/detect/transition3class-yolo26s-1280/weights/best.pt
PAPI_DEVICE=cpu
PAPI_STORAGE_DIR=storage
PAPI_STORAGE_BACKEND=local
PAPI_BLOB_CONTAINER=papi-media
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
PAPI_API_KEY=
PAPI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
PAPI_CONFIDENCE_THRESHOLD=0.4
# Transition derivation when a request sends neither model_id nor transition_method:
# tracking (temporal flips) | model (learned 3-class events, needs the transition model).
PAPI_TRANSITION_METHOD=tracking
# Explicit inference size/IoU so a re-exported model can't silently fall back to 640.
PAPI_INFERENCE_IMGSZ=1280
PAPI_INFERENCE_IOU=0.7
PAPI_MAX_UPLOAD_MB=100
# Decompression-bomb guard for single images.
PAPI_MAX_IMAGE_MEGAPIXELS=80
PAPI_MAX_VIDEO_FRAMES=600
PAPI_MAX_VIDEO_SECONDS=150
# Aggregate request-body cap for folder/batch uploads. Under Docker the frontend
# nginx also caps bodies at 410m (apps/frontend/nginx.conf) — raise both together.
PAPI_MAX_BATCH_UPLOAD_MB=400
# Max images accepted per /api/analyze-frames folder upload (also caps /api/analyze-sequence).
PAPI_MAX_BATCH_FRAMES=200
# Model lifecycle writable stores. Defaults live under PAPI_STORAGE_DIR; override
# these for bare-metal runs if large uploaded weights/datasets should live on a
# separate disk.
PAPI_USER_MODELS_DIR=storage/user_models
PAPI_DATASETS_DIR=storage/datasets
PAPI_JOBS_DIR=storage/jobs
PAPI_MAX_MODEL_UPLOAD_MB=500
PAPI_MAX_DATASET_UPLOAD_MB=500
PAPI_MAX_DATASET_EXTRACT_MB=4000
PAPI_TRAINING_ENABLED=true
# FPS for a folder->video sequence (/api/analyze-sequence treats a folder of images
# as consecutive video frames). Affects annotated playback speed only, not detection.
PAPI_SEQUENCE_FPS=4
PAPI_RATE_LIMIT_ENABLED=true
PAPI_RATE_LIMIT_PER_MINUTE=600
PAPI_ANALYZE_RATE_LIMIT_PER_MINUTE=60
