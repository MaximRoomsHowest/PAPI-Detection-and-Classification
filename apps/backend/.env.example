# local (default) keeps the production security floor off; set "production" at
# real deploy time (then a PAPI_API_KEY and a non-default DATABASE_URL are required).
PAPI_ENV=local
# DATABASE_URL (shown) and PAPI_DATABASE_URL are both accepted.
DATABASE_URL=postgresql+psycopg://papi:papi@localhost:5434/papi_backend
PAPI_MODEL_REGISTRY_PATH=../../models/serving/models.json
PAPI_MODEL_PATH=../../models/serving/best.pt
# Optional override if the ignored transition classifier exists locally.
# PAPI_TRANSITION_MODEL_PATH=../../data/runs/detect/transition3class-yolo26s-1280/weights/best.pt
PAPI_DEVICE=cpu
PAPI_STORAGE_DIR=storage
PAPI_API_KEY=
PAPI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
PAPI_CONFIDENCE_THRESHOLD=0.4
PAPI_VIDEO_HISTORY_SIZE=5
PAPI_MAX_UPLOAD_MB=100
PAPI_MAX_VIDEO_FRAMES=600
PAPI_MAX_VIDEO_SECONDS=30
# Max images accepted per /api/analyze-frames folder upload (also caps /api/analyze-sequence).
PAPI_MAX_BATCH_FRAMES=200
# FPS for a folder->video sequence (/api/analyze-sequence treats a folder of images
# as consecutive video frames). Affects annotated playback speed only, not detection.
PAPI_SEQUENCE_FPS=4
