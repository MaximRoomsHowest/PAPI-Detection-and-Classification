node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output (regenerated inside the container)
dist/
.vite/

# Local secrets / settings
.env
.env.*
!.env.example

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Project meta we don't need at build time
README.md
Dockerfile
.dockerignore
# NOTE: nginx.conf.template and nginx.azure.conf.template MUST stay in the build context — the
# Dockerfile copies the selected one (ARG NGINX_CONF) to /etc/nginx/templates/default.conf.template,
# which the stock nginx envsubst entrypoint renders into /etc/nginx/conf.d/default.conf at container
# start. Excluding a *.template breaks `docker compose up --build` (see audit SMOKE-CRIT-1).
