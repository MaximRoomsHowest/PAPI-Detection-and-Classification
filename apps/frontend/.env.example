VITE_PAPI_API_URL=http://127.0.0.1:8000

# Optional: API key the frontend sends as X-API-Key. Note that anything
# inlined into the bundle is visible to anyone who downloads the page, so
# this is not a real security boundary — see audit F-CRIT-3.
# VITE_PAPI_API_KEY=

# Optional client-side request timeouts (genuinely client-side, so they stay build-time).
# Upload SIZE / batch-FRAME limits are NOT set here any more: the client fetches them from
# the backend's /api/limits at runtime, so the backend PAPI_MAX_UPLOAD_MB /
# PAPI_MAX_BATCH_UPLOAD_MB / PAPI_MAX_BATCH_FRAMES are the single source of truth and a .env
# change reaches the browser without rebuilding the bundle (audit F-MAJ-8).
# VITE_PAPI_REQUEST_TIMEOUT_MS=60000
# Long-running analyze requests get their own timeout (video inference is slow).
# VITE_PAPI_ANALYZE_TIMEOUT_MS=600000
