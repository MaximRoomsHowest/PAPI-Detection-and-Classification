# PAPI Vision frontend — nginx config TEMPLATE for the static React bundle.
#
# Rendered at container start by the stock nginx 20-envsubst-on-templates.sh
# (COPY'd to /etc/nginx/templates/default.conf.template; output lands at
# /etc/nginx/conf.d/default.conf). envsubst substitutes ONLY ${VARS} that are
# defined in the container environment — keep this file free of any ${...}
# except the body-size knob below; nginx runtime vars ($host, $uri, ...) are
# unbraced and therefore safe (audit IS-7).
#
# Runs under nginxinc/nginx-unprivileged: listens on 8080 (the image cannot
# bind <1024 without root). The Compose port mapping exposes it publicly.
#
# This server is ALSO the single public origin: it reverse-proxies /api, /media
# and /health to the backend service, so the browser only ever talks to one
# origin (same-origin). That removes the need for CORS and for listing the
# backend host in the CSP, and means the production bundle is built with an
# empty VITE_PAPI_API_URL (relative URLs) (audit DCK-D4).

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # ----------------------------------------------------------------------
    # Security headers (audit F-MAJ-13 / DCK-MAJ-6)
    # ----------------------------------------------------------------------
    # Applied to every response, including the SPA index.html. ``always`` is
    # important — without it, nginx skips these on 4xx/5xx responses. (The
    # /assets/ block re-declares them because nginx drops inherited add_header
    # directives in any location that sets its own — audit DCK-RE NGINX-1.)
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # Content-Security-Policy. Because the API + media are reverse-proxied
    # through this same origin (see the /api and /media blocks below), the
    # backend host is NOT in the allowlist any more — 'self' covers it, so the
    # policy is tighter than the old cross-origin version (audit DCK-D4).
    # Allows:
    #   - self for scripts/styles/fonts/api/media (same-origin bundle + proxy)
    #   - data: + blob: for object URLs (video frames, jsPDF exports)
    #   - 'unsafe-inline' for styles because Plotly + Vite inject inline styles
    #   - the OSM tile server for the iframe-embedded map on the intro page
    # IMPORTANT: this MUST be one line — nginx does not support multi-line
    # add_header continuations; backslashes get sent literally to the browser,
    # which then rejects the entire policy.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://*.tile.openstreetmap.org https://www.openstreetmap.org; media-src 'self' blob: data:; connect-src 'self'; frame-src https://www.openstreetmap.org; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self';" always;

    # ----------------------------------------------------------------------
    # Reverse proxy to the backend — same-origin API + media (audit DCK-D4)
    # ----------------------------------------------------------------------
    # ``backend`` resolves on the Compose network; depends_on: service_healthy
    # guarantees it is up before nginx starts. We re-resolve it per-request via
    # Docker's embedded DNS (127.0.0.11) + a variable in proxy_pass, so recreating
    # JUST the backend container — which gives it a new compose-network IP, e.g.
    # `docker compose up -d backend` after a code change — does NOT 502 every request
    # until the frontend is also restarted. The variable is what forces nginx to
    # re-resolve instead of caching the backend IP at worker start. (proxy_pass has no
    # URI part, so the original /api, /media, /health request URI is forwarded unchanged.)
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $papi_upstream backend;
    location /api/ {
        proxy_pass http://$papi_upstream:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Folder/sequence uploads send up to PAPI_MAX_BATCH_UPLOAD_MB (400 MB default)
        # + multipart headroom; a lower cap 413s a real batch upload before it reaches
        # the backend. Env-templated (audit IS-7): set NGINX_CLIENT_MAX_BODY_SIZE on the
        # frontend container (compose: PAPI_NGINX_MAX_BODY_SIZE) to follow any
        # PAPI_MAX_BATCH_UPLOAD_MB override without rebuilding the image. The backend's
        # own transport cap sits at the same budget + 10 MB (app/middleware.py).
        client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};
        # A single video/batch analysis runs for minutes at ~0.4 fps — must not
        # be cut off by nginx's 60s default. Matches the frontend analyze timeout.
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
    }

    location /media/ {
        proxy_pass http://$papi_upstream:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
        proxy_buffering off;
    }

    # Health probes, handy for external uptime checks hitting the public origin.
    location = /health        { proxy_pass http://$papi_upstream:8000; }
    location = /health/ready  { proxy_pass http://$papi_upstream:8000; }

    # Hashed JS/CSS assets — long-cache.
    location /assets/ {
        access_log off;
        expires 1y;
        # nginx drops ALL inherited add_header directives when a location sets
        # its own, so the security headers are repeated here for hashed assets
        # (audit DCK-RE NGINX-1). CSP is document-scoped and omitted on purpose.
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
        try_files $uri =404;
    }

    # SPA fallback — every unknown route returns index.html so react-router can take over.
    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_vary on;
    gzip_min_length 256;
    gzip_proxied any;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml;
}
